  _lines:
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uAE30\uC9C0 \uB0B4\uBD80\uC758 \uC5F0\uAD6C\uC2DC\uC124\uC5D0 \uC870\uC0AC
      \uB370\uC774\uD130\uAC00 \uB0A8\uC544\uC788\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC804\uCCB4 \uB9F5\uC5D0\uC11C \uB370\uC774\uD130 \uD68C\uC218 \uAD6C\uC5ED\uC744
      \uD655\uC778\uD558\uACE0, \uD574\uB2F9 \uAD6C\uC5ED\uC758 \uCEF4\uD4E8\uD130\uC5D0\uC11C
      \uB370\uC774\uD130\uB97C \uD655\uBCF4\uD574 \uC8FC\uC2ED\uC2DC\uC624."
