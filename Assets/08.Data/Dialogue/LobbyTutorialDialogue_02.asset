  m_Script: {fileID: 11500000, guid: 905744162f169c047b061ba71cd84598, type: 3}
  m_Name: LobbyTutorialDialogue_02
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _dialogueId: lobby_tutorial_02
  _lines:
  - _speakerName: "\uBD80\uAD00"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC774\uACF3\uC5D0\uC11C\uB294 \uD0D0\uC0AC \uAC00\uB2A5\uD55C \uD589\uC131\uACFC
      \uC758\uB8B0\uB4E4, \uD604\uC7AC \uC218\uB77D\uD55C \uC758\uB8B0\uB97C \uD655\uC778
      \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uBD80\uAD00"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC758\uB8B0\uB9C8\uB2E4 \uC704\uD5D8\uB3C4\uC640 \uBAA9\uD45C\uAC00
      \uB2E4\uB974\uBA70, \uB09C\uB3C4\uAC00 \uB192\uC744\uC218\uB85D \uB354 \uC88B\uC740
      \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uBD80\uAD00"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC544\uC9C1 \uBA85\uC131\uC774 \uCDA9\uBD84\uD558\uC9C0 \uC54A\uC544
      \uBAA8\uB4E0 \uD589\uC131\uC5D0 \uC9C4\uC785\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uBD80\uAD00"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uD604\uC7AC \uB3C4\uC804 \uAC00\uB2A5\uD55C \uC758\uB8B0 \uD589\uC131\uC740
      \uC544\uC6B0\uB810\uB9AC\uC544 \uC785\uB2C8\uB2E4.\n\uC544\uC6B0\uB810\uB9AC\uC544\uB97C
      \uC120\uD0DD\uD574 \uCCAB \uBC88\uCA30 \uC758\uB8B0\uB97C \uC2DC\uC791\uD574
      \uC8FC\uC138\uC694."
