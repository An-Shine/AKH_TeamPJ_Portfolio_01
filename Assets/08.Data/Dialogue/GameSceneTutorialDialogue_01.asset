  _dialogueId: GameScene_Tutorial_DIalogue01
  _lines:
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC2E0\uD638 \uBC1C\uC0DD\uC9C0\uC810\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uD589\uC131 \uC704\uCE58 \uC815\uBCF4\uB97C \uC804\uC1A1\uD588\uC73C\uB2C8
      \uD655\uC778\uD574 \uC8FC\uC2ED\uC2DC\uC624."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "Tab \uD0A4\uB85C \uC804\uCCB4 \uC9C0\uD615\uC744 \uD655\uC778\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uBB34\uAE30 \uC0AC\uC6A9\uBC95\uACFC \uC870\uC791 \uC548\uB0B4\uB294
      \uC6B0\uCE21 \uD558\uB2E8\uC744 \uCC38\uACE0\uD574 \uC8FC\uC2ED\uC2DC\uC624."
