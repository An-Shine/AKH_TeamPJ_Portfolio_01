  _dialogueId: lobby_tutorial_01
  _lines:
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC548\uB155\uD558\uC138\uC694 \uC800\uB294 \uC774 \uC6B0\uC8FC\uC120\uC758
      \uC2E4\uBB34\uB2F4\uB2F9 \uC81C\uB85C \uB77C\uACE0\uD569\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uCD9C\uBC1C\uC5D0 \uC55E\uC11C \uD655\uC778\uD558\uC154\uC57C\uD560
      \uB0B4\uC6A9\uB4E4\uC774 \uC788\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC758\uB8B0 \uB9AC\uC2A4\uD2B8\uAC00 \uC5C5\uB370\uC774\uD2B8 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC9C0\uAE08
      \uBC14\uB85C \uC0C1\uB2E8\uC758 \uC758\uB8B0 \uD0ED\uC744 \uD655\uC778\uD574\uC8FC\uC138\uC694."
