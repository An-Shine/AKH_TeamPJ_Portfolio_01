  _dialogueId: GameScene_Tutorial_DIalogue05
  _lines:
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uB370\uC774\uD130 \uD68C\uC218\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uD655\uBCF4\uD55C \uC811\uADFC \uAD8C\uD55C\uC73C\uB85C \uAE30\uC9C0
      \uC911\uC559\uC758 \uC7A0\uAE34 \uBB38\uC744 \uD574\uC81C\uD588\uC2B5\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uBB38 \uB108\uBA38\uC5D0\uC11C \uAC15\uB825\uD55C \uC0DD\uCCB4 \uC2E0\uD638\uAC00
      \uAC10\uC9C0\uB429\uB2C8\uB2E4."
  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uC911\uC559 \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD574 \uAC70\uB300\uAD34\uC218\uC640\uC758
      \uC870\uC6B0\uB97C \uC900\uBE44\uD558\uC138\uC694."
