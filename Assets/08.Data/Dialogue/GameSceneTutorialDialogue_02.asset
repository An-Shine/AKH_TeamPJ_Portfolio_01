  - _speakerName: "\uC81C\uB85C"
    _portrait: {fileID: 3651158108210696409, guid: 37ef2a97b62b8754b8095bfc97519cf6, type: 3}
    _text: "\uACBD\uACE0. \uC804\uBC29\uC5D0\uC11C \uB2E4\uC218\uC758 \uC0DD\uCCB4\uC2E0\uD638\uAC00
      \uAC10\uC9C0\uB429\uB2C8\uB2E4. \n\uC804\uD22C\uB97C \uC900\uBE44\uD574\uC8FC\uC2ED\uC2DC\uC624."
  - _speakerName: "\uC81C\uB85C"
